<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151728"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="#2A2D45"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_logged_in_as"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/profileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_email_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/changePasswordBtn"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_password"
            android:backgroundTint="#2A2D45"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/changeEmailBtn"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_email"
            android:backgroundTint="#2A2D45"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/deleteAccountBtn"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_delete_account"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
