<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="32dp"
    android:background="#0D1B2A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Create Account"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#A8FF3E"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/registerErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D32F2F"
        android:visibility="gone" />

    <TextView
        android:id="@+id/registerSuccessMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#388E3C"
        android:visibility="gone" />

    <EditText
        android:id="@+id/registerEmailInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Email"
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/edit_text_bg"
        android:backgroundTint="#1C2B3A"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/registerPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Password"
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/edit_text_bg"
        android:backgroundTint="#1C2B3A"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/confirmPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Confirm password"
        android:textColorHint="#FFFFFF"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/edit_text_bg"
        android:backgroundTint="#1C2B3A"
        android:inputType="textPassword"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/createAccountBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Create Account"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1A2A0A"
        android:backgroundTint="#A8FF3E"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/backToLoginBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Back to login"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1C2B3A" />

</LinearLayout>